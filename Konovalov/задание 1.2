import random

def simulate_coin_collection(days=365, max_denomination=10000):
    collected = set()
    discarded_count = 0
    
    for _ in range(days):
        denomination = random.randint(1, max_denomination)
        
        if denomination in collected:
            discarded_count += 1
        else:
            collected.add(denomination)
    
    return collected, discarded_count

DAYS = 365
MAX_DENOMINATION = 10000

collected_coins, discarded_count = simulate_coin_collection(DAYS, MAX_DENOMINATION)

print(f"""
КОЛЛЕКЦИЯ МОНЕТ АЛИСЫ:
Всего дней: {DAYS}
Диапазон номиналов: 1-{MAX_DENOMINATION}
Уникальных монет собрано: {len(collected_coins)}
Монет выброшено: {discarded_count}
Номиналы собранных монет: {sorted(collected_coins)}
""")
