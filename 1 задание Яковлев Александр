class Person:
    def __init__(self, name, salary, rent, spending, savings_rate, travel_expense, travel_period):
        self.name = name
        self.salary = salary
        self.rent = rent
        self.spending = spending
        self.savings_rate = savings_rate
        self.travel_expense = travel_expense
        self.travel_period = travel_period
        self.balance = 100000  
        self.month = 0

    def monthly_expense(self):
        return self.rent + self.spending

    def monthly_income(self):
        return self.salary

    def apply_travel(self):
        if self.travel_period and self.travel_period > 0 and (self.month + 1) % self.travel_period == 0:
            self.balance -= self.travel_expense

    def month_end(self):
        net = self.monthly_income() - self.monthly_expense()
        self.balance += net
        self.apply_travel()
        self.month += 1


class Alice(Person):
    def __init__(self, salary, mortgage_debt, monthly_interest_rate):
        super().__init__(
            name="Alice",
            salary=salary,
            rent=0,
            spending=75000,
            savings_rate=0,
            travel_expense=0,
            travel_period=None
        )
        self.mortgage_debt = mortgage_debt
        self.monthly_interest_rate = monthly_interest_rate
        term_months = 30 * 12
        self.monthly_payment = (
            mortgage_debt * monthly_interest_rate
            / (1 - (1 + monthly_interest_rate) ** -term_months)
        )

    def monthly_expense(self):
        return self.spending  

    def month_end(self):
        net_base = self.monthly_income() - self.monthly_expense()
        self.balance += net_base

        if self.mortgage_debt > 0.01: 
            interest = self.mortgage_debt * self.monthly_interest_rate
            principal = min(self.monthly_payment - interest, self.mortgage_debt) 
            total_payment = interest + principal
            self.balance -= total_payment
            self.mortgage_debt -= principal
        else:
            self.mortgage_debt = 0.0

        self.month += 1


class Bob(Person):
    def __init__(self, salary, rent, spending):
        super().__init__(
            name="Bob",
            salary=salary,
            rent=rent,
            spending=spending,
            savings_rate=10000,
            travel_expense=4000,
            travel_period=10
        )


def calculate_finances(total_months):
    mortgage_amount = 10_000_000
    annual_interest_rate = 0.12
    monthly_interest_rate = annual_interest_rate / 12

    alice = Alice(200_000, mortgage_amount, monthly_interest_rate)
    bob = Bob(80_000, 50_000, 30_000)

    for _ in range(total_months):
        bob.month_end()
        alice.month_end()

    return bob, alice

input_time = input("Введите время в годах (например, 2.5 для 2 лет 6 мес): ").strip()
try:
    years_float = float(input_time)
    total_months = int(round(years_float * 12))
    years = int(years_float)
    months = int(round((years_float - years) * 12))
except ValueError:
    print("❌ Некорректный ввод. Используется 0 лет.")
    total_months = 0
    years = months = 0

bob, alice = calculate_finances(total_months)

print("\n" + "="*50)
print(f"Через {years} лет и {months} месяцев ({total_months} мес.):")
print("="*50)
print(f"💰 Боб:")
print(f"  Баланс: {bob.balance:,.2f} ₽")

print(f"\n🏡 Алиса:")
print(f"  Наличный баланс: {alice.balance:,.2f} ₽")
print(f"  Остаток ипотеки: {alice.mortgage_debt:,.2f} ₽")
print(f"  Чистое финансовое положение (баланс - долг): {alice.balance - alice.mortgage_debt:,.2f} ₽")
print("="*50)
