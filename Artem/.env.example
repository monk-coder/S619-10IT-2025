# === API КЛЮЧИ ===
# Получите ключ на https://openweathermap.org/api
OPENWEATHER_API_KEY=ваш_ключ_от_openweathermap

# === НАСТРОЙКИ OLLAMA ===
# Обычно не нужно менять, если Ollama запущен локально
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:1b

# === ОПЦИОНАЛЬНО ===
# Если хотите использовать другой поиск (расширение)
DUCKDUCKGO_TIMEOUT=10