!pip install -r requirements.txt -q
from huggingface_hub import login
login()  # Введи свой HF token с правом write

import os
import torch
from datasets import load_dataset, DatasetDict
from transformers import (
    AutoModelForCausalLM, AutoTokenizer, 
    BitsAndBytesConfig, DataCollatorForLanguageModeling,
    Trainer, TrainingArguments
)
from peft import LoraConfig, get_peft_model, prepare_model_for_kbit_training

# [2] Загрузка данных и split 90/10
squad = load_dataset("squad_v2")
# Оставляем только вопросы с ответами для стабильного обучения
train_ds = squad["train"].filter(lambda x: len(x["answers"]["text"]) > 0)
val_ds = squad["validation"].filter(lambda x: len(x["answers"]["text"]) > 0)
squad_90_10 = DatasetDict({"train": train_ds, "val": val_ds})

print(f"Train: {len(squad_90_10['train'])}, Val: {len(squad_90_10['val'])}")

# [3] Форматирование и токенизация
prompt_template = "Context: {context}\nQuestion: {question}\nAnswer: {answer}"
tokenizer = AutoTokenizer.from_pretrained("meta-llama/Llama-3.2-1B")
if tokenizer.pad_token is None:
    tokenizer.pad_token = tokenizer.eos_token
    tokenizer.padding_side = "right"

def format_fn(example):
    answer = example["answers"]["text"][0]
    text = prompt_template.format(
        context=example["context"],
        question=example["question"],
        answer=answer
    )
    return {"text": text}

squad_90_10 = squad_90_10.map(format_fn, remove_columns=squad_90_10["train"].column_names)

def tokenize_fn(batch):
    return tokenizer(batch["text"], truncation=True, max_length=512)

squad_90_10 = squad_90_10.map(tokenize_fn, batched=True, remove_columns=["text"])

# [4] QLoRA модель
bnb_config = BitsAndBytesConfig(
    load_in_4bit=True,
    bnb_4bit_quant_type="nf4",
    bnb_4bit_compute_dtype=torch.float16,
    bnb_4bit_use_double_quant=True
)

model = AutoModelForCausalLM.from_pretrained(
    "meta-llama/Llama-3.2-1B",
    quantization_config=bnb_config,
    device_map="auto",
    torch_dtype=torch.float16
)
model = prepare_model_for_kbit_training(model)

# [5] LoRA Config (строго по заданию)
lora_config = LoraConfig(
    r=16,
    lora_alpha=32,
    target_modules=["q_proj", "v_proj"],
    lora_dropout=0.05,
    bias="none",
    task_type="CAUSAL_LM"
)
model = get_peft_model(model, lora_config)
model.print_trainable_parameters()

# [6] Training Args & Trainer
training_args = TrainingArguments(
    output_dir="./lora_squad_output",
    per_device_train_batch_size=4,
    max_steps=500,
    learning_rate=2e-4,
    warmup_ratio=0.1,
    fp16=True,
    logging_steps=50,
    save_steps=100,
    save_strategy="steps",
    report_to="none",
    remove_unused_columns=False,
    gradient_accumulation_steps=1,
    optim="paged_adamw_8bit"
)

data_collator = DataCollatorForLanguageModeling(tokenizer, mlm=False)

trainer = Trainer(
    model=model,
    args=training_args,
    train_dataset=squad_90_10["train"],
    data_collator=data_collator
)

# [7] Запуск обучения
trainer.train()

# [8] Сохранение и пуш на HF
adapter_name = "yourname/squad-llama-lora"  # замени на свой username
trainer.model.save_pretrained("./squad_lora_adapter")
tokenizer.save_pretrained("./squad_lora_adapter")

