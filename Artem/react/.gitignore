# === СЕКРЕТЫ И КОНФИГИ ===
# Никогда не заливать в репозиторий!
.env
.env.local
*.key
*.pem

# === PYTHON ===
# Кэши и временные файлы
__pycache__/
*.py[cod]
*$py.class
*.so

# Виртуальные окружения (venv, venv3, .venv)
venv/
env/
.venv/
ENV/

# Дистрибутивы и сборки
build/
dist/
*.egg-info/

# === IDE И РЕДАКТОРЫ ===
# Настройки редакторов (не нужны другим)
.idea/
.vscode/
*.swp
*.swo
*~

# === JUPYTER И NOTEBOOKS ===
.ipynb_checkpoints/

# === ТЕСТЫ И ОТЧЁТЫ ===
# Локальные результаты, которые не нужно коммитить
evaluation_report.json
*.log
reports/

# === ОС-СПЕЦИФИЧНЫЕ ФАЙЛЫ ===
# Системные файлы, которые мешают
.DS_Store              # macOS
Thumbs.db              # Windows
ehthumbs.db            # Windows
Desktop.ini            # Windows

# === ОПЦИОНАЛЬНО: большие файлы ===
# Если вдруг появятся датасеты или модели
*.zip
*.tar.gz
data/
models/
