class Bob:
    BOB_SALARY = 80000
    BOB_RENT = 30000
    BOB_FOOD = 4000
    BOB_TRANSPORT = 1500
    BOB_CAT_FOOD = 2000
    BOB_CAT_GROOMING = 1500  # За два месяца
    BOB_EXPENSES = [BOB_FOOD, BOB_TRANSPORT, BOB_CAT_FOOD, BOB_CAT_GROOMING]

    def __init__(self):
        self.balance = 0

    def monthly_update(self):
        # Увеличиваем баланс на зарплату и уменьшаем на расходы
        self.balance += self.BOB_SALARY
        self.balance -= (sum(self.BOB_EXPENSES) + self.BOB_RENT)

    def annual_update(self):
        # Увеличиваем баланс на зарплату и уменьшаем на расходы (включая индексацию аренды)
        self.balance += self.BOB_SALARY * 12
        self.BOB_RENT *= 1.05  # Индексация аренды на 5%
        self.balance -= (sum(self.BOB_EXPENSES) * 12 + self.BOB_RENT)


class Alice:
    ALICE_SALARY = 200000
    ALICE_LOAN_PAYMENT = 100000  # Выплата по ипотеке
    ALICE_FOOD = 4000
    ALICE_TRANSPORT = 1500
    ALICE_EXPENSES = [ALICE_FOOD, ALICE_TRANSPORT]

    def __init__(self):
        self.balance = 0

    def monthly_update(self):
        # Увеличиваем баланс на зарплату и уменьшаем на расходы
        self.balance += self.ALICE_SALARY
        self.balance -= (sum(self.ALICE_EXPENSES) + self.ALICE_LOAN_PAYMENT)

    def annual_update(self):
        # Увеличиваем баланс на зарплату и уменьшаем на расходы (включая проценты по ипотеке)
        self.balance += self.ALICE_SALARY * 12
        interest = (self.ALICE_LOAN_PAYMENT * 0.12)  # Проценты годовые
        self.balance -= (interest + self.ALICE_LOAN_PAYMENT)  # Общая сумма выплат по ипотеке за год
        self.balance -= (sum(self.ALICE_EXPENSES) * 12)


def simulate_life(months_or_years, number_of_periods):
    bob = Bob()
    alice = Alice()

    if months_or_years == 1:  # Месяцы
        for _ in range(number_of_periods):
            bob.monthly_update()
            alice.monthly_update()
    elif months_or_years == 2:  # Годы
        for _ in range(number_of_periods):
            bob.annual_update()
            alice.annual_update()
            
    print(f"Баланс Боба через {number_of_periods} {'месяцев' if months_or_years == 1 else 'лет'}: {bob.balance:.2f}")
    print(f"Баланс Алисы через {number_of_periods} {'месяцев' if months_or_years == 1 else 'лет'}: {alice.balance:.2f}")


def get_input():
    while True:
        try:
            months_or_years = int(input("Введите 1 для месяцев или 2 для лет: "))
            number_of_periods = int(input("Введите количество периодов: "))
            if months_or_years in [1, 2] and number_of_periods >= 0:
                return months_or_years, number_of_periods
            else:
                print("Пожалуйста, введите корректные значения.")
        except ValueError:
            print("Ввод некорректен. Пожалуйста, введите числа.")


# Главная программа
if __name__ == "__main__":
    while True:
        months_or_years, number_of_periods = get_input()
        simulate_life(months_or_years, number_of_periods)
        another_simulation = input("Хотите провести еще один расчет? (да/нет): ").strip().lower()
        if another_simulation != 'да':
            print("Спасибо за использование программы!")
            break
