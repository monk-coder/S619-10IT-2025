# ПАРАМЕТРЫ
BOB_SALARY = 80000
BOB_RENT = 30000
BOB_FOOD = 4000
BOB_TRANSPORT = 1500
BOB_CAT_FOOD = 2000
BOB_CAT_GROOMING = 3000
BOB_RENT_INFLATION = 0.05

ALICE_SALARY = 200000
ALICE_APARTMENT_PRICE = 10000000
ALICE_DOWN_PAYMENT = 2000000
ALICE_FOOD = 4000
ALICE_TRANSPORT = 1500
ALICE_MORTGAGE_RATE = 0.12
ALICE_MORTGAGE_YEARS = 20


class Person:
    def __init__(self, name, salary):
        self.name = name
        self.salary = salary
        self.savings = 0
        self.months = 0
        self.total_income = 0
        self.total_expenses = 0


class Bob(Person):
    def __init__(self):
        super().__init__("Bob", BOB_SALARY)
        self.rent = BOB_RENT
        self.grooming_counter = 0

    def simulate_month(self):
        self.months += 1
        self.grooming_counter += 1

        # Доход
        self.savings += self.salary
        self.total_income += self.salary

        # Расходы
        expenses = self.rent + BOB_FOOD + BOB_TRANSPORT + BOB_CAT_FOOD

        if self.grooming_counter >= 2:
            expenses += BOB_CAT_GROOMING
            self.grooming_counter = 0

        if self.months % 12 == 0:
            self.rent += int(self.rent * BOB_RENT_INFLATION)

        self.savings -= expenses
        self.total_expenses += expenses

        return expenses


class Alice(Person):
    def __init__(self):
        super().__init__("Alice", ALICE_SALARY)

        self.loan = ALICE_APARTMENT_PRICE - ALICE_DOWN_PAYMENT
        self.mortgage_months = ALICE_MORTGAGE_YEARS * 12
        monthly_rate = ALICE_MORTGAGE_RATE / 12

        numerator = self.loan * monthly_rate * (1 + monthly_rate) ** self.mortgage_months
        denominator = (1 + monthly_rate) ** self.mortgage_months - 1
        self.mortgage_payment = int(numerator / denominator)

        self.remaining_loan = self.loan

    def simulate_month(self):
        self.months += 1

        # Доход
        self.savings += self.salary
        self.total_income += self.salary

        # Расходы
        expenses = self.mortgage_payment + ALICE_FOOD + ALICE_TRANSPORT

        interest = self.remaining_loan * (ALICE_MORTGAGE_RATE / 12)
        principal = self.mortgage_payment - interest
        self.remaining_loan -= principal

        if self.remaining_loan < 0:
            self.remaining_loan = 0

        self.savings -= expenses
        self.total_expenses += expenses

        return expenses


def main():
    # Ввод количества лет
    while True:
        try:
            years = float(input("Введите количество лет для симуляции: "))
            if years > 0:
                break
            print("Введите число больше 0")
        except:
            print("Ошибка! Введите число")

    # Создание персонажей
    bob = Bob()
    alice = Alice()

    months = int(years * 12)

    # Симуляция
    for month in range(1, months + 1):
        bob.simulate_month()
        alice.simulate_month()

    # Результаты
    print(f"\nРезультаты за {years} лет:")
    print(f"Bob: сбережения = {bob.savings:,} руб, аренда = {bob.rent:,} руб")
    print(f"Alice: сбережения = {alice.savings:,} руб, долг = {int(alice.remaining_loan):,} руб")

    # Сравнение
    difference = alice.savings - bob.savings
    print(f"\nРазница: {difference:,} руб")

    if alice.remaining_loan <= 0:
        print("Alice выплатила ипотеку!")
    else:
        years_left = alice.remaining_loan / (alice.mortgage_payment * 12)
        print(f"Alice осталось платить ипотеку: {years_left:.1f} лет")


if __name__ == "__main__":
    main()
