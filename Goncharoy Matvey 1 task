import random


class Bob:
    def __init__(self):
        self.balance = 100_000
        self.salary = 80_000
        self.rent = 30_000
        self.food = 4_000
        self.transport = 1_500
        self.cat_food = 2_000
        self.cat_grooming = 3_000
        self.months_passed = 0

    def calculate_expenses(self):
        expenses = self.rent + self.food + self.transport + self.cat_food
        if self.months_passed % 2 == 0:
            expenses += self.cat_grooming
        return expenses

    def check_bonus(self):
        if random.randint(1, 10) == 1:
            return 150_000
        return 0

    def update_month(self):
        self.months_passed += 1
        income = self.salary + self.check_bonus()
        expenses = self.calculate_expenses()
        self.balance += income - expenses

        # Индексация аренды каждые 12 месяцев
        if self.months_passed % 12 == 0:
            self.rent = int(self.rent * 1.05)


class Alice:
    def __init__(self):
        self.balance = 100_000
        self.salary = 200_000
        self.food = 4_000
        self.transport = 1_500
        self.mortgage_amount = 10_000_000
        self.mortgage_rate = 0.12  # годовая ставка
        self.mortgage_term = 20 * 12  # срок в месяцах
        self.debt = self.mortgage_amount
        # Предварительный расчёт аннуитетного платежа (фиксированный)
        self.monthly_payment = self._calculate_annuity_payment()

    def _calculate_annuity_payment(self):
        if self.mortgage_amount <= 0 or self.mortgage_term <= 0:
            return 0
        r = self.mortgage_rate / 12  # месячная ставка
        n = self.mortgage_term
        # Формула аннуитета: P = S * r * (1 + r)^n / ((1 + r)^n - 1)
        numerator = r * (1 + r) ** n
        denominator = (1 + r) ** n - 1
        payment = self.mortgage_amount * (numerator / denominator)
        return payment

    def pay_mortgage(self):
        if self.debt <= 0:
            return 0

        monthly_rate = self.mortgage_rate / 12
        interest = self.debt * monthly_rate
        principal = self.monthly_payment - interest

        if principal > self.debt:
            principal = self.debt

        self.debt -= principal
        return interest + principal

    def calculate_expenses(self):
        return self.food + self.transport

    def update_month(self):
        income = self.salary
        mortgage_payment = self.pay_mortgage()
        expenses = self.calculate_expenses()
        self.balance += income - mortgage_payment - expenses


def simulate(years):
    bob = Bob()
    alice = Alice()

    for _ in range(years * 12):
        bob.update_month()
        alice.update_month()

    return bob.balance, alice.balance


def print_results(years, bob_balance, alice_balance):
    print(f"Через {years} год(а/лет): Боб — {bob_balance:,.0f} руб., Алиса — {alice_balance:,.0f} руб.")


def run_simulation():
    print("=== Симуляция жизни Боба и Алисы ===\n")

    for years in [1, 5, 10, 20, 25]:
        bob_bal, alice_bal = simulate(years)
        print_results(years, bob_bal, alice_bal)

    print("\n" + "=" * 50)

    try:
        n = int(input("\nСколько лет смоделировать (1–100)? "))
        if 1 <= n <= 100:
            bob_bal, alice_bal = simulate(n)
            print(f"\nЧерез {n} лет: Боб — {bob_bal:,.0f} руб., Алиса — {alice_bal:,.0f} руб.")
        else:
            print("Число должно быть от 1 до 100.")
    except ValueError:
        print("Введите целое число.")


if __name__ == "__main__":
    run_simulation()
